{
    "name": "TaskZen - Modern Task Manager",
    "short_name": "TaskZen",
    "description": "A powerful, offline-first task manager with advanced productivity features for all devices",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#ffffff",
    "theme_color": "#4a90e2",
    "lang": "en",
    "dir": "ltr",
    "categories": ["productivity", "business", "utilities"],
    "shortcuts": [
        {
            "name": "Add Task",
            "short_name": "New Task",
            "description": "Quickly add a new task",
            "url": "/?action=add-task",
            "icons": [{ "src": "src/assets/icons/shortcut-add.png", "sizes": "96x96" }]
        },
        {
            "name": "View Tasks",
            "short_name": "Tasks",
            "description": "View all tasks",
            "url": "/?view=tasks",
            "icons": [{ "src": "src/assets/icons/shortcut-tasks.png", "sizes": "96x96" }]
        },
        {
            "name": "Kanban Board",
            "short_name": "Kanban",
            "description": "Open Kanban board view",
            "url": "/?view=kanban",
            "icons": [{ "src": "src/assets/icons/shortcut-kanban.png", "sizes": "96x96" }]
        }
    ],
